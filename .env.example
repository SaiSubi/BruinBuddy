# Copy to .env and fill in. .env is git-ignored.
OPENROUTER_API_KEY=
TUTOR_MODEL=anthropic/claude-sonnet-5.5
HELPER_MODEL=anthropic/claude-haiku-5.5
# Optional: a second model tried once if the tutor model fails before sending any text
TUTOR_FALLBACK_MODEL=
# Set to 1 to run with a fake LLM (no key, no cost) for UI/dev testing only
BB_MOCK_LLM=0
# Optional: trace answers in Langfuse (https://langfuse.com) to analyse and improve them. Off when empty.
# Langfuse project > Settings > API Keys. Use the US region host below (or your self-hosted URL).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
# Share of answers traced, 0 to 1 (lower it if the free tier fills up)
LANGFUSE_SAMPLE_RATE=1.0

# Accounts. Leave these empty for local email + password accounts (development only).
# To use Supabase Auth locally: AUTH_PROVIDER=supabase plus SUPABASE_URL and SUPABASE_ANON_KEY.
AUTH_PROVIDER=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Payments. Leave empty to use the built-in test checkout page (no Stripe account needed).
# For the real Stripe sandbox: the test-mode secret key (sk_test_...) and the webhook signing secret (whsec_...).
# Locally, `stripe listen --forward-to localhost:8000/api/stripe/webhook` prints a whsec_ secret to use here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
