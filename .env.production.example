# Production settings. Copy to .env.production (git-ignored) and fill in. Never commit real values.
# Push each one to Fly with:  fly secrets set KEY=value -a bruinbuddy-api
ENV=production
# Supabase: Project Settings > Database > Connection string > "Transaction pooler" (port 6543). Replace [YOUR-PASSWORD].
DATABASE_URL=
OPENROUTER_API_KEY=
TUTOR_MODEL=anthropic/claude-sonnet-5.5
HELPER_MODEL=anthropic/claude-haiku-5.5
TUTOR_FALLBACK_MODEL=
# Supabase project URL: https://<project-ref>.supabase.co
SUPABASE_URL=
# Storage (private bucket for course files). Project Settings > API Keys > secret / service_role key. Server-side only.
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=course-pdfs
# Auth. Project Settings > API Keys > anon / publishable key. Public by design: the backend hands it to the browser.
AUTH_PROVIDER=supabase
SUPABASE_ANON_KEY=
# Stripe sandbox (test mode only in v1). Developers > API keys > Secret key (sk_test_...).
# Developers > Webhooks > add endpoint https://bruinbuddy-api.fly.dev/api/stripe/webhook with events
# checkout.session.completed and checkout.session.async_payment_succeeded, then copy its signing secret (whsec_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Random string; generated for you by deploy/init_env.py
SECRET_KEY=
# Your Vercel URL, comma-separated if more than one. APP_URL is where Stripe sends people back after checkout.
ALLOWED_ORIGINS=
APP_URL=
# App-wide cost backstop: questions per rolling 24 hours across all courses
GLOBAL_DAILY_LIMIT=600
# Demo only: new student accounts join this course id automatically (0 or unset = off)
DEFAULT_COURSE_ID=0
# EMBED_MODEL=openai/text-embedding-3-small   # hybrid retrieval; change only with a re-run of app.retrieval_eval
