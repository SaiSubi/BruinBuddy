# Production settings. Copy to .env.production (git-ignored) and fill in. Never commit real values.
ENV=production
# Supabase: Project Settings > Database > Connection string > "Transaction pooler" (port 6543). Replace [YOUR-PASSWORD].
DATABASE_URL=
OPENROUTER_API_KEY=
# Supabase Storage (private bucket for the public PDFs). Project URL is https://<project-ref>.supabase.co
# Service key: Project Settings > API Keys > secret / service_role key. Server-side only; never in the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=course-pdfs
TUTOR_MODEL=anthropic/claude-sonnet-5.5
HELPER_MODEL=anthropic/claude-haiku-5.5
# Random strings; generated for you by deploy/init_env.py
SECRET_KEY=
STUDENT_CODE=
PROFESSOR_CODE=
# Your Vercel URL (set after the first Vercel deploy), comma-separated if more than one
ALLOWED_ORIGINS=
DAILY_MESSAGE_LIMIT=40
GLOBAL_DAILY_LIMIT=200
